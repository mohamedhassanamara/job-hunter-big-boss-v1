# Copy this to .env and adjust as needed
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
DB_PATH=./data/app.db

# --- Email sending (queues feature) ---
# Gmail: enable 2-Step Verification, then generate an App Password at
# https://myaccount.google.com/apppasswords — do NOT use your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SENDER_NAME=Your Name
REPLY_TO_ADDRESS=
# Practical safety net only — Google's actual limits can change; not enforced as fact, just a guardrail.
DAILY_SEND_CAP=500
QUEUE_ITEM_CAP=20
QUEUE_SEND_INTERVAL_MIN_SECONDS=300
QUEUE_SEND_INTERVAL_MAX_SECONDS=420
SENDER_LOOP_POLL_SECONDS=20
